    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "animejs": "^4.0.2",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "ws": "^8.18.0"
